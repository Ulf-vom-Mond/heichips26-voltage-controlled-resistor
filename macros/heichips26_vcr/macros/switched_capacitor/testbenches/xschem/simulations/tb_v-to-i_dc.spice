.param temp=27
.options savecurrents klu method=gear reltol=1e-3 abstol=1e-15 gmin=1e-15
.control

save all

* Operating Point Analysis
op
remzerovec
write tb_v-to-i_dc.raw
set appendwrite

* DC Sweep
dc Vg 3.3 0 -0.01
remzerovec
write tb_v-to-i_dc.raw
set appendwrite

* Plotting
plot i(vout1)
plot deriv(i(vout1)) mean(deriv(i(vout1)))
plot i(VDD)
